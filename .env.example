# ---------------------------------------------------------------------------
# Database (SQLite + Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# AI: Ollama (runs locally on the dev machine)
# https://ollama.com  ->  ollama pull llama3.2:3b
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# ---------------------------------------------------------------------------
# Product search: Channel3 (optional). Leave blank to use the built-in
# deterministic fallback catalogue.
# ---------------------------------------------------------------------------
CHANNEL3_API_KEY=""
CHANNEL3_API_URL="https://api.trychannel3.com"

# ---------------------------------------------------------------------------
# Payments: PayPal Sandbox (server-side). Get these from
# https://developer.paypal.com/dashboard/applications/sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is exposed to the browser SDK.
# ---------------------------------------------------------------------------
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_CURRENCY="USD"
