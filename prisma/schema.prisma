generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Singleton row (id = "singleton") holding the user's monthly income and the
/// free-text goals/priorities used to guide the AI budget suggestion.
model Settings {
  id            String   @id @default("singleton")
  salary        Float    @default(0)
  goals         String?
  /// Day of the month the budget period starts on (1-31). Lets the period
  /// follow a payday instead of always starting on the 1st.
  monthStartDay Int      @default(1)
  updatedAt     DateTime @updatedAt
}

/// A spending category, optionally carrying a budget cap.
model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#6366f1")
  budget    Float?
  purchases Purchase[]
  createdAt DateTime   @default(now())
}

/// A recorded purchase (manual entry or imported PayPal activity).
model Purchase {
  id              String        @id @default(cuid())
  description     String
  amount          Float
  merchant        String?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Set when this purchase was generated by a PayPal milestone checkout.
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// True when the user hand-corrected the AI category guess.
  userCategorized Boolean       @default(false)
  aiConfidence    Float?
  occurredAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  /// Set when this purchase was created from a group expense share, so the
  /// personal budget only ever contains the member's own share.
  groupShare      ExpenseShare?
}

/// A thing the user wants to buy, with optional constraints.
/// SQLite does not support Prisma enums, so priority is a string:
/// "LOW" | "MEDIUM" | "HIGH".
model DesiredItem {
  id               String     @id @default(cuid())
  name             String
  notes            String?
  /// User-provided target price. Used when no cheaper alternative is chosen.
  targetPrice      Float
  priority         String     @default("MEDIUM")
  targetDate       DateTime?
  /// Product link the user pasted in, if any.
  url              String?
  category         String?
  purchased        Boolean    @default(false)
  /// Set when the user swaps in a cheaper alternative.
  alternativeName  String?
  alternativePrice Float?
  alternativeUrl   String?
  milestoneId      String?
  milestone        Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
}

/// An AI-generated affordable grouping of desired items.
model Milestone {
  id        String        @id @default(cuid())
  title     String
  rationale String?
  /// Order in the staged plan (1 = do first).
  sequence  Int           @default(1)
  status    String        @default("PLANNED")
  items     DesiredItem[]
  createdAt DateTime      @default(now())
}

/// A PayPal order created for a milestone checkout.
model Order {
  id             String     @id @default(cuid())
  paypalOrderId  String     @unique
  milestoneId    String?
  milestoneTitle String?
  /// Immutable item selection and prices approved at checkout (JSON).
  checkoutItems  String?
  amount         Float
  currency       String     @default("USD")
  status         String     @default("CREATED")
  /// Raw capture response for auditing.
  captureId      String?
  purchases      Purchase[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Group spending split
//
// Money in this feature is stored in integer minor units (cents) so that
// shares always add up to the expense total exactly. Groups are account-less:
// a member is just a display name, with one member optionally marked as "you"
// so the UI can show "you owe" and copy only your share into the personal
// budget.
// ---------------------------------------------------------------------------

model Group {
  id          String         @id @default(cuid())
  name        String
  currency    String         @default("USD")
  members     GroupMember[]
  expenses    GroupExpense[]
  settlements Settlement[]
  directionChanges RepaymentDirectionChange[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GroupMember {
  id                  String         @id @default(cuid())
  groupId             String
  group               Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  displayName         String
  /// Marks the member that represents the local user in this demo. No real
  /// accounts yet; this flag only drives "you owe" and budget export.
  isSelf              Boolean        @default(false)
  /// Placeholder for a future real user identity (email / account id).
  userId              String?
  /// PayPal email or PayPal.Me handle. Used to build request/pay links.
  paypalAddress       String?
  expensesPaid        GroupExpense[] @relation("ExpensePayer")
  shares              ExpenseShare[]
  settlementsSent     Settlement[]   @relation("SettlementSender")
  settlementsReceived Settlement[]   @relation("SettlementRecipient")
  reversalsFrom       RepaymentDirectionChange[] @relation("ReversalFrom")
  reversalsTo         RepaymentDirectionChange[] @relation("ReversalTo")
  createdAt           DateTime       @default(now())

  @@unique([groupId, displayName])
  @@index([groupId])
}

model GroupExpense {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId     String
  payer       GroupMember    @relation("ExpensePayer", fields: [payerId], references: [id])
  description String
  amountCents Int
  /// Optional category label (e.g. "Groceries", "Travel").
  category    String?
  occurredAt  DateTime       @default(now())
  shares      ExpenseShare[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([groupId])
}

model ExpenseShare {
  id          String       @id @default(cuid())
  expenseId   String
  expense     GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId    String
  member      GroupMember  @relation(fields: [memberId], references: [id])
  amountCents Int
  /// The personal-budget purchase created from this share, if the user chose
  /// to copy it over. Deleting the purchase leaves the share in place.
  purchaseId  String?      @unique
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  /// Optional expense whose participant share this payment covers.
  expenseId        String?
  id               String      @id @default(cuid())
  groupId          String
  group            Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId         String
  sender           GroupMember @relation("SettlementSender", fields: [senderId], references: [id])
  recipientId      String
  recipient        GroupMember @relation("SettlementRecipient", fields: [recipientId], references: [id])
  amountCents      Int
  /// PENDING while a PayPal order is awaiting capture; SETTLED once confirmed
  /// (or when the user marks a manual repayment as settled).
  status           String      @default("PENDING")
  /// PayPal order id for the settlement request, when one was created.
  paypalOrderId    String?     @unique
  /// Confirmed capture id (or a manual reference such as "cash").
  paymentReference String?
  note             String?
  settledAt        DateTime?
  createdAt        DateTime    @default(now())

  @@index([groupId])
}

/// An explicit correction to an unpaid suggested repayment, not a payment.
/// Stores the original direction; balances move by twice the amount to reverse it.
model RepaymentDirectionChange {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("ReversalFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("ReversalTo", fields: [toMemberId], references: [id])
  amountCents  Int
  createdAt    DateTime    @default(now())

  @@index([groupId])
}
